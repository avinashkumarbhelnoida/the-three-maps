THE_THREE_MAPS_ENV=development
THE_THREE_MAPS_DB_PATH=the_three_maps_local.sqlite3
THE_THREE_MAPS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
THE_THREE_MAPS_RATE_LIMIT_PER_MINUTE=120
THE_THREE_MAPS_MAX_BODY_BYTES=2000000
